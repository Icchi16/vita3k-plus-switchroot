+int Atrac9DecodeBounded(void* handle, const unsigned char *pAtrac9Buffer, int bufferBytes, short *pPcmBuffer, int *pNBytesUsed)
+{
+	if (!pNBytesUsed) return ERR_BAD_CONFIG_DATA;
+	*pNBytesUsed = 0;
+	if (!handle || !pAtrac9Buffer || !pPcmBuffer || bufferBytes < 0 || !((Atrac9Handle*)handle)->Initialized)
+		return ERR_BAD_CONFIG_DATA;
+	if (bufferBytes == 0) return ERR_UNPACK_INPUT_TOO_SHORT;
+	return DecodeBounded(handle, pAtrac9Buffer, bufferBytes, (unsigned char*)pPcmBuffer, pNBytesUsed);
